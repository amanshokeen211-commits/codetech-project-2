import pandas as pd
from typing import Tuple
import yaml

class TextDataset(Dataset):
    def __init__(self, texts, labels, tokenizer, max_length):
        self.texts = texts
        self.labels = labels
        self.tokenizer = tokenizer
        self.max_length = max_length
    
    def __len__(self):
        return len(self.texts)
    
    def __getitem__(self, idx):
        text = str(self.texts[idx])
        label = self.labels[idx]
        
        # Tokenize text
        encoding = self.tokenizer(
            text,
            truncation=True,
            padding='max_length',
            max_length=self.max_length,
            return_tensors='pt'
        )
        
        return {
            'input_ids': encoding['input_ids'].flatten(),
            'attention_mask': encoding['attention_mask'].flatten(),
            'labels': torch.tensor(label, dtype=torch.long)
        }

class NLPDataLoader:
    def __init__(self, config_path: str):
        with open(config_path, 'r') as file:
            self.config = yaml.safe_load(file)
        
        self.tokenizer = BertTokenizer.from_pretrained(
            self.config['bert']['model_name']
        )
        self.max_length = self.config['data']['max_length']
        self.batch_size = self.config['data']['batch_size']
    
    def load_dataset(self) -> Tuple[DataLoader, DataLoader]:
        """Load and preprocess text dataset"""
        dataset_name = self.config['data']['dataset_name']
        
        if dataset_name == "imdb":
            dataset = load_dataset("imdb")
            train_data = dataset['train']
            test_data = dataset['test']
        elif dataset_name == "sst2":
            dataset = load_dataset("glue", "sst2")
            train_data = dataset['train']
            test_data = dataset['validation']
        else:
            # For custom dataset, expect CSV with 'text' and 'label' columns
            raise ValueError(f"Unsupported dataset: {dataset_name}")
        
        # Create datasets
        train_dataset = TextDataset(
            texts=train_data['text'],
            labels=train_data['label'],
            tokenizer=self.tokenizer,
            max_length=self.max_length
        )
        
        test_dataset = TextDataset(
            texts=test_data['text'],
            labels=test_data['label'],
            tokenizer=self.tokenizer,
            max_length=self.max_length
        )
        
        # Create data loaders
        train_loader = DataLoader(
            train_dataset,
            batch_size=self.batch_size,
            shuffle=True,
            num_workers=2
        )
        
        test_loader = DataLoader(
            test_dataset,
            batch_size=self.batch_size,
            shuffle=False,
            num_workers=2
        )
        
        return train_loader, test_loader
    
    def create_custom_dataloader(self, texts: list, labels: list, shuffle: bool = True) -> DataLoader:
        """Create DataLoader for custom data"""
        dataset = TextDataset(
            texts=texts,
            labels=labels,
            tokenizer=self.tokenizer,
            max_length=self.max_length
        )
        
        return DataLoader(
            dataset,
            batch_size=self.batch_size,
            shuffle=shuffle,
            num_workers=2
        )
