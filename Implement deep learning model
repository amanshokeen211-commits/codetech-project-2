import tensorflow as tf
from tensorflow.keras import layers, Model
import yaml

class CNNModel:
    def __init__(self, config_path: str):
        with open(config_path, 'r') as file:
            self.config = yaml.safe_load(file)
    
    def build_model(self) -> Model:
        """Build CNN model based on config"""
        model_config = self.config['model']
        input_shape = (*self.config['data']['image_size'], 3)  # RGB images
        
        # Input layer
        inputs = tf.keras.Input(shape=input_shape)
        
        # Initial convolution block
        x = layers.Conv2D(
            model_config['filters'][0], 
            kernel_size=3, 
            activation=model_config['activation'],
            padding='same'
        )(inputs)
        x = layers.BatchNormalization()(x)
        x = layers.MaxPooling2D(pool_size=2)(x)
        
        # Additional convolution blocks
        for filters in model_config['filters'][1:]:
            x = layers.Conv2D(
                filters, 
                kernel_size=3, 
                activation=model_config['activation'],
                padding='same'
            )(x)
            x = layers.BatchNormalization()(x)
            x = layers.MaxPooling2D(pool_size=2)(x)
            x = layers.Dropout(model_config['dropout_rate'] / 2)(x)
        
        # Flatten and dense layers
        x = layers.Flatten()(x)
        
        for units in model_config['dense_units']:
            x = layers.Dense(units, activation=model_config['activation'])(x)
            x = layers.BatchNormalization()(x)
            x = layers.Dropout(model_config['dropout_rate'])(x)
        
        # Output layer
        outputs = layers.Dense(
            model_config['num_classes'], 
            activation='softmax'
        )(x)
        
        model = Model(inputs=inputs, outputs=outputs)
        
        return model
    
    def build_resnet_model(self) -> Model:
        """Build ResNet model using pre-trained weights"""
        input_shape = (*self.config['data']['image_size'], 3)
        
        # Load pre-trained ResNet50
        base_model = tf.keras.applications.ResNet50(
            weights='imagenet',
            include_top=False,
            input_shape=input_shape
        )
        
        # Freeze base model layers
        base_model.trainable = False
        
        # Add custom classifier
        inputs = tf.keras.Input(shape=input_shape)
        x = base_model(inputs, training=False)
        x = layers.GlobalAveragePooling2D()(x)
        x = layers.Dense(512, activation='relu')(x)
        x = layers.Dropout(0.5)(x)
        outputs = layers.Dense(self.config['model']['num_classes'], activation='softmax')(x)
        
        model = Model(inputs=inputs, outputs=outputs)
        return model
