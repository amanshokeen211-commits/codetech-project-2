import torch
import torch.nn as nn
from transformers import BertModel, BertPreTrainedModel
import yaml

class BERTClassifier(nn.Module):
    def __init__(self, config_path: str):
        super(BERTClassifier, self).__init__()
        
        with open(config_path, 'r') as file:
            self.config = yaml.safe_load(file)
        
        self.bert = BertModel.from_pretrained(self.config['bert']['model_name'])
        self.dropout = nn.Dropout(self.config['model']['dropout'])
        self.classifier = nn.Linear(
            self.bert.config.hidden_size,
            self.config['model']['num_classes']
        )
        
        # Freeze BERT layers if not fine-tuning
        if not self.config['bert']['fine_tune']:
            for param in self.bert.parameters():
                param.requires_grad = False
    
    def forward(self, input_ids, attention_mask):
        outputs = self.bert(
            input_ids=input_ids,
            attention_mask=attention_mask
        )
        
        pooled_output = outputs.pooler_output
        pooled_output = self.dropout(pooled_output)
        logits = self.classifier(pooled_output)
        
        return logits

class LSTMClassifier(nn.Module):
    def __init__(self, config_path: str, vocab_size: int, embedding_dim: int = 300):
        super(LSTMClassifier, self).__init__()
        
        with open(config_path, 'r') as file:
            self.config = yaml.safe_load(file)
        
        self.embedding = nn.Embedding(vocab_size, embedding_dim)
        self.lstm = nn.LSTM(
            embedding_dim,
            self.config['model']['hidden_dim'],
            num_layers=self.config['model']['num_layers'],
            batch_first=True,
            dropout=self.config['model']['dropout'] if self.config['model']['num_layers'] > 1 else 0,
            bidirectional=True
        )
        self.dropout = nn.Dropout(self.config['model']['dropout'])
        self.classifier = nn.Linear(
            self.config['model']['hidden_dim'] * 2,  # bidirectional
            self.config['model']['num_classes']
        )
    
    def forward(self, input_ids, attention_mask):
        embeddings = self.embedding(input_ids)
        
        lstm_out, (hidden, cell) = self.lstm(embeddings)
        
        # Use the last hidden state
        hidden = torch.cat((hidden[-2,:,:], hidden[-1,:,:]), dim=1)
        hidden = self.dropout(hidden)
        logits = self.classifier(hidden)
        
        return logits
