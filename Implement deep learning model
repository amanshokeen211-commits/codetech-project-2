import tensorflow as tf
import numpy as np
import yaml
from typing import Tuple, Optional
import os

class ImageDataLoader:
    def __init__(self, config_path: str):
        with open(config_path, 'r') as file:
            self.config = yaml.safe_load(file)
        
        self.image_size = tuple(self.config['data']['image_size'])
        self.batch_size = self.config['data']['batch_size']
    
    def load_dataset(self) -> Tuple[tf.data.Dataset, tf.data.Dataset]:
        """Load and preprocess image dataset"""
        dataset_name = self.config['data']['dataset_name']
        
        if dataset_name == "cifar10":
            (x_train, y_train), (x_test, y_test) = tf.keras.datasets.cifar10.load_data()
        elif dataset_name == "cifar100":
            (x_train, y_train), (x_test, y_test) = tf.keras.datasets.cifar100.load_data()
        elif dataset_name == "mnist":
            (x_train, y_train), (x_test, y_test) = tf.keras.datasets.mnist.load_data()
            # Add channel dimension for MNIST
            x_train = np.expand_dims(x_train, -1)
            x_test = np.expand_dims(x_test, -1)
        else:
            raise ValueError(f"Unsupported dataset: {dataset_name}")
        
        # Normalize pixel values
        x_train = x_train.astype('float32') / 255.0
        x_test = x_test.astype('float32') / 255.0
        
        # Resize images if needed
        if x_train.shape[1:3] != self.image_size:
            x_train = tf.image.resize(x_train, self.image_size)
            x_test = tf.image.resize(x_test, self.image_size)
        
        # Convert labels to categorical if needed
        num_classes = self.config['model']['num_classes']
        y_train = tf.keras.utils.to_categorical(y_train, num_classes)
        y_test = tf.keras.utils.to_categorical(y_test, num_classes)
        
        # Create data augmentation
        data_augmentation = self._create_augmentation()
        
        # Create TensorFlow datasets
        train_dataset = tf.data.Dataset.from_tensor_slices((x_train, y_train))
        train_dataset = train_dataset.map(
            lambda x, y: (data_augmentation(x, training=True), y),
            num_parallel_calls=tf.data.AUTOTUNE
        )
        train_dataset = train_dataset.shuffle(10000).batch(self.batch_size).prefetch(tf.data.AUTOTUNE)
        
        test_dataset = tf.data.Dataset.from_tensor_slices((x_test, y_test))
        test_dataset = test_dataset.batch(self.batch_size).prefetch(tf.data.AUTOTUNE)
        
        return train_dataset, test_dataset
    
    def _create_augmentation(self) -> tf.keras.Sequential:
        """Create data augmentation pipeline"""
        augmentation_config = self.config['augmentation']
        
        augmentation_layers = []
        
        if augmentation_config['rotation_range'] > 0:
            augmentation_layers.append(
                tf.keras.layers.RandomRotation(augmentation_config['rotation_range'] / 360.0)
            )
        
        if augmentation_config['width_shift_range'] > 0 or augmentation_config['height_shift_range'] > 0:
            augmentation_layers.append(
                tf.keras.layers.RandomTranslation(
                    height_factor=augmentation_config['height_shift_range'],
                    width_factor=augmentation_config['width_shift_range']
                )
            )
        
        if augmentation_config['horizontal_flip']:
            augmentation_layers.append(tf.keras.layers.RandomFlip("horizontal"))
        
        if augmentation_config['zoom_range'] > 0:
            augmentation_layers.append(
                tf.keras.layers.RandomZoom(augmentation_config['zoom_range'])
            )
